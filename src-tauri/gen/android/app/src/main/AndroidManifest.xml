<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The media session's service runs in the foreground while music plays (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- CPU and Wi-Fi stay up while streaming with the screen off, released on every pause. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Local music: read the audio files in a folder the user picked (asked on the first
         "Add folder", never at start). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Phones, tablets, Chromebooks, DeX: no touchscreen requirement, keyboard and mouse work. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No backup: the app's database holds the signed-in session's cookies (see
         data_extraction_rules.xml for Android 12+, where allowBackup alone no longer covers
         device-to-device transfer). -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.limusic_app"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google's sign-in page in a WebView profile of its own (SignInActivity.kt). Not exported:
             only the app opens it. -->
        <activity
            android:name=".SignInActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- Instead of the app when Android System WebView is too old for it (WebViewSupport). -->
        <activity
            android:name=".WebViewNoticeActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation"
            android:resizeableActivity="true"
            android:exported="false" />

        <service
            android:name=".PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
